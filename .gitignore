# ─────────────────────────────────────────────────────────────────────────────
# Unity — 3D Pull-The-World
# Based on github/gitignore/Unity.gitignore, with project-specific additions.
# Root-anchored (leading /) wherever a same-named folder could legitimately
# exist inside Assets/, so we never ignore real project content by accident.
# ─────────────────────────────────────────────────────────────────────────────

# Unity-generated caches and build intermediates
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
/[Aa]rtifacts/
/[Cc]odeCoverage/
/.utmp/
/ExportedObj/
/[Aa]ssets/[Ss]treamingAssets/aa*

# Asset meta files must be kept for everything we DO commit
!/[Aa]ssets/**/*.meta

# Auto-generated VS / Rider / MSBuild project files (Unity regenerates these)
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE / editor local state
.vs/
.vscode/
.idea/
.gradle/
.consulo/
**/Plugins/Editor/JetBrains*
RiderScriptEditorPersistedState.asset

# Claude Code local (machine-specific) settings — shared settings.json is tracked
.claude/settings.local.json

# Node — the MCP bridge server's dependencies and compiled output are
# reinstallable via `npm ci && npm run build` inside Packages/mcp-unity/Server~
node_modules/
/[Pp]ackages/mcp-unity/Server~/build/
/[Pp]ackages/mcp-unity/Server~/log.txt
/[Pp]ackages/mcp-unity/Server~/log.txt.meta

# Test + capture output (regenerated by the PlayMode test run — see README)
/[Cc]aptures/
results.xml
*.TestResults.xml

# Concept-art reference from a parallel session; not used by the build.
# README's "Known gaps" explicitly says to exclude this on git init.
/PicReference/

# Builds / packages / crash reports
*.apk
*.aab
*.unitypackage
*.app
*.ipa
/[Bb]uild[Rr]eports/
build-output.properties
crashlytics-build.properties
sysinfo.txt

# Credential-bearing files (must never be committed)
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
.env
.env.*
!.env.example
**/GoogleService-Info*.plist*
**/google-services*.json*
secrets.json

# OS cruft
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.orig
*.orig.meta
